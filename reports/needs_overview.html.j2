{#- Starter report — a single, self-contained HTML document rendered from
    your needs index. Render it standalone with
    `ubc report needs_overview.html.j2` (writes reports/_build/needs_overview.html),
    or from VS Code's Reports view:
      • "Generate & Preview" — fast, themed, in-editor preview (static HTML only).
      • "Open in Browser"     — writes the same _build/ file and opens your real
        browser, where <script> and external CSS/JS run. Use this for dynamic
        content the in-editor preview can't show.
    This template stays script-free (pure inline SVG) so it renders identically
    everywhere — editor, browser, email, and print. -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Needs Overview</title>
  <style>
    {# The `--ub-*` design tokens: the editor's theme inside the VS Code
       report preview, built-in light and dark colors everywhere else
       (browser, email, print), so the document stays self-contained. #}
    {{ theme_style() }}
    body { font-family: var(--ub-font); max-width: 900px; margin: 2em auto; padding: 0 1em; color: var(--ub-fg); background: var(--ub-bg); }
    h1, h2 { border-bottom: 1px solid var(--ub-border); padding-bottom: 4px; }
    .muted { color: var(--ub-muted); font-size: 0.85em; }
    table { border-collapse: collapse; width: 100%; }
    th, td { border: 1px solid var(--ub-border); padding: 4px 8px; text-align: left; }
    th { background: var(--ub-surface); }
    code { font-family: var(--ub-font-mono); background: var(--ub-surface); padding: 1px 4px; border-radius: 3px; }
    svg text { fill: var(--ub-fg); }
  </style>
</head>
<body>

  <h1>Needs Overview</h1>
  <p class="muted">
    {{ needs|length }} needs ·
    {{ needs_list|groupby('type')|length }} types ·
    {{ needs_list|groupby('status')|length }} statuses
  </p>

  {% if needs|length == 0 %}
  <p><em>No needs found. Index the project and re-run this report.</em></p>
  {% else %}

  {# The first bar colors are theme tokens (they follow the editor's theme
     in the VS Code preview), the rest fixed colors. SVG presentation
     attributes cannot resolve var(), so fills are set via the style
     attribute. #}
  {% set palette = [
    'var(--ub-accent)', 'var(--ub-ok)', 'var(--ub-warn)', 'var(--ub-error)',
    '#8b5cf6', '#f97316', '#06b6d4', '#ec4899'
  ] %}
  {% set groups = needs_list|groupby('type') %}

  <h2>Needs per type</h2>
  {# A pure inline-SVG bar chart: no JavaScript, renders identically in
     any browser, email client, or print/PDF output. Bar lengths are
     scaled to the largest group so the chart fills its width. #}
  {% set max_count = groups|map('last')|map('length')|max %}
  <svg viewBox="0 0 640 {{ groups|length * 32 + 4 }}" role="img" aria-label="Needs per type">
    {% for type, group in groups %}
    <g transform="translate(0, {{ loop.index0 * 32 }})">
      <text x="0" y="19" font-size="13">{{ type }}</text>
      <rect x="110" y="4" height="22" width="{{ (group|length / max_count * 480)|round(1) }}"
            style="fill: {{ palette[loop.index0 % (palette|length)] }}" rx="3"></rect>
      <text x="{{ 116 + (group|length / max_count * 480)|round(1) }}" y="19" font-size="13">{{ group|length }}</text>
    </g>
    {% endfor %}
  </svg>

  <h2>Needs per status</h2>
  <table>
    <thead><tr><th>Status</th><th>Count</th></tr></thead>
    <tbody>
      {% for status, group in needs_list|groupby('status') %}
      <tr><td>{{ status or "(none)" }}</td><td>{{ group|length }}</td></tr>
      {% endfor %}
    </tbody>
  </table>

  <h2>All needs</h2>
  <table>
    <thead><tr><th>ID</th><th>Type</th><th>Title</th><th>Status</th></tr></thead>
    <tbody>
      {% for n in needs_list %}
      <tr>
        <td><code>{{ n.id }}</code></td>
        <td>{{ n.type }}</td>
        <td>{{ n.title }}</td>
        <td>{{ n.status or "" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% endif %}
</body>
</html>
